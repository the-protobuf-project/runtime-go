BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Example//Test//EN
BEGIN:VEVENT
UID:meeting@example.com
DTSTART:20260420T140000Z
DTEND:20260420T150000Z
SUMMARY:Quarterly review
DESCRIPTION:The event description, not the alarm one.
ORGANIZER;CN=Jane Doe;SENT-BY="mailto:assistant@example.com":mailto:jane@exam
 ple.com
ATTENDEE;CN=Bob;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;RSVP=TRUE;CUTYPE=INDI
 VIDUAL:mailto:bob@example.com
ATTENDEE;CN=Board Room;ROLE=NON-PARTICIPANT;CUTYPE=ROOM:mailto:room3@example
 .com
ATTENDEE;ROLE=OPT-PARTICIPANT;PARTSTAT=DELEGATED;DELEGATED-TO="mailto:carol@
 example.com":mailto:dave@example.com
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;RELATED=START:-PT15M
DESCRIPTION:Starts in 15 minutes
REPEAT:2
DURATION:PT5M
END:VALARM
BEGIN:VALARM
ACTION:EMAIL
TRIGGER;VALUE=DATE-TIME:20260420T120000Z
SUMMARY:Reminder subject
DESCRIPTION:Reminder body
ATTENDEE:mailto:bob@example.com
END:VALARM
END:VEVENT
END:VCALENDAR
